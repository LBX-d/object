# 后端配置文件示例：复制本文件为 .env 后按需修改
# 所有配置项都有代码内默认值，不建 .env 也能直接运行

# 数据库路径（SQLite 文件）
# DATABASE_PATH=data/defect_detection.db

# YOLOv8 模型文件路径
# MODEL_PATH=models/best.pt

# 上传原图 / 检测结果图 / 临时文件 / 日志 目录
# UPLOAD_DIR=uploads
# RESULT_DIR=results
# TEMP_DIR=temp
# LOG_DIR=logs

# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# 检测参数
# CONF_THRESHOLD=0.25
# IOU_THRESHOLD=0.45
# IMG_SIZE=640
# MAX_UPLOAD_SIZE_MB=10
# INFERENCE_TIMEOUT=60
